<Mod>
	<Name>Music</Name>
	<Author>wizz6rd</Author>
	<Version>0.1.0</Version>

	<Description>
	Twelve instrument blocks: piano, guitar, bass, strings, brass, woodwind,
	plucked, mallets, drums, cymbals, an FM synth and Braids, a port of Mutable
	Instruments' macro-oscillator. Each plays a note on a key, heard where
	it is.

	Block models by jeremy, Daniel Melchior and Poly by Google, from Poly Pizza,
	under CC-BY 3.0. Sampled instruments cut from MuseScore_General.
	</Description>

	<Icon name="Music_icon" />
	<Debug>false</Debug>
	<MultiplayerCompatible>true</MultiplayerCompatible>

	<Assemblies>
		<Assembly path="Music.dll" />
	</Assemblies>

	<Blocks>
		<Block path="Piano.xml" />
		<Block path="Guitar.xml" />
		<Block path="Bass.xml" />
		<Block path="Strings.xml" />
		<Block path="Brass.xml" />
		<Block path="Woodwind.xml" />
		<Block path="Mallets.xml" />
		<Block path="Drums.xml" />
		<Block path="Cymbals.xml" />

		<Block path="Plucked.xml" />

		<!-- The one block that is not a recording: two-operator FM, for the synth
		     leads and pads a fifth of a modern score is made of. -->
		<Block path="FMSynth.xml" />

		<!-- The Braids block: Mutable Instruments' macro-oscillator, ported. It was
		     a mod of its own and is now one of these, block and panel unchanged. -->
		<Block path="Braids.xml" />

		<!-- Not an instrument: the block that turns a MIDI file into a machine. -->
		<Block path="Loader.xml" />
	</Blocks>

