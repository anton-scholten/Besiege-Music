<Block>
	<Debug>false</Debug>
	<ID>7</ID>
	<Name>Mallets</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>mallets</Keyword>
		<Keyword>vibraphone</Keyword>
		<Keyword>marimba</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<MusicMod modid="aca735ea-a614-4aef-9676-67ec1edd5059" block="Mallets">
			<Types>
			<!-- Recordings, where these were rung on the modal engine until now. A
			     bar or a bell is what modal synthesis is *for*, and it still came
			     second: what it cannot do is the mallet against the bar, the
			     resonator tube under it, or the noise of the strike itself.
			     `decay` is now the ring-out past the end of the recording, and
			     Hardness and Motor still work — see InstrumentBehaviour.Resolve. -->
			<Type name="Glockenspiel"  engine="sampler" samples="mallet_glock_79 mallet_glock_84 mallet_glock_96" loops="34974-35873 35074-35873 34909-35873" decay="3.0" />
			<Type name="Vibraphone"    engine="sampler" samples="mallet_vibes_57 mallet_vibes_66 mallet_vibes_78" loops="7338-8842 4680-4800 2748-2807" decay="4.0" />
			<!-- Unlooped, and it matters: the font leaves the loop points of a
			     sample it does *not* loop spanning the whole of it, and read as a
			     loop that is the recording played a second time. See
			     SampleBank.FindTail, which is what rings these out instead. -->
			<Type name="Marimba"       engine="sampler" samples="mallet_marimba_48 mallet_marimba_60 mallet_marimba_66" decay="1.2" />
			<Type name="Xylophone"     engine="sampler" samples="mallet_xylo_60 mallet_xylo_72 mallet_xylo_84" decay="0.7" />
			<!-- The one that stays synthesised. Every General MIDI font gives the
			     tubular bells a single recording for the whole range — this one
			     is a C7 — and a bell stretched three octaves down is a slow, dull
			     imitation of a bell. Modal rings real partials at whatever pitch
			     it is asked for, which for a struck metal tube is the honest way. -->
			<Type name="Tubular bells" engine="modal" decay="6.0" brightness="0.30" inharmonicity="1.05" noise="0.10" />
			<Type name="Steel drum"    engine="sampler" samples="mallet_steel_66 mallet_steel_72 mallet_steel_84" decay="1.6" />
			</Types>
			<Extras>
			<Extra kind="slider" key="HardKey" name="Hardness" min="0" max="1" default="0.5" />
			<Extra kind="slider" key="MotorKey" name="Motor" min="0" max="1" default="0" />
			</Extras>
		</MusicMod>
	</Modules>

	<Mesh name="Mallets_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="Mallets_texture" />

	<Icon>
		<Position x="0.0" y="0.0" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-36.1" y="166.3" z="-168.7" /> <!--how the toolbar sees it: the bars along the tile, facing right-->
		<Scale x="0.5" y="0.5" z="0.5" />
	</Icon>
	
	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
		<Position x="0" y="0" z="0.3" />
		<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" /> 
	</BasePoint>
	
	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
