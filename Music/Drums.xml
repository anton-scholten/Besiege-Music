<Block>
	<Debug>false</Debug>
	<ID>8</ID>
	<Name>Drums</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>drums</Keyword>
		<Keyword>kick</Keyword>
		<Keyword>snare</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<MusicMod modid="aca735ea-a614-4aef-9676-67ec1edd5059" block="Drums">
			<Types>
			<!-- The kit, cut from General MIDI's own percussion bank rather than
			     synthesised. Each is one recording: a drum has no range to cover,
			     and what the block's NOTE does to it is tune it, which is what a
			     drummer does to a kit. Published at note 60, where the slider
			     starts, so a block placed by hand plays it as recorded.
			     No loops — a one-shot rings out on its own tail. -->
			<Type name="Kick"  engine="sampler" samples="drum_kick_60"  decay="0.45" />
			<Type name="Snare" engine="sampler" samples="drum_snare_60" decay="0.40" />
			<Type name="Tom"   engine="sampler" samples="drum_tom_60"   decay="0.60" />
			<Type name="Rim"   engine="sampler" samples="drum_rim_60"   decay="0.20" />
			<Type name="Clap"  engine="sampler" samples="drum_clap_60"  decay="0.30" />
			</Types>
			<Extras>
			<Extra kind="slider" key="TuneKey" name="Tune" min="-12" max="12" default="0" />
			<Extra kind="slider" key="DecayKey" name="Decay" min="0.05" max="60" dragMax="3" default="0.45" />
			<Extra kind="slider" key="DampKey" name="Damping" min="0" max="1" default="0.3" />
			</Extras>
		</MusicMod>
	</Modules>

	<Mesh name="Drums_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="Drums_texture" />

	<Icon>
		<Position x="0.0" y="0.0" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-31.3" y="156.7" z="-151.6" /> <!--how the toolbar sees it: looking down at the head, which faces right-->
		<Scale x="0.4" y="0.4" z="0.4" /> <!--a drum is as wide as the block is, and filled its tile-->
	</Icon>
	
	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
		<Position x="0" y="0" z="0.3" />
		<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" /> 
	</BasePoint>
	
	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
