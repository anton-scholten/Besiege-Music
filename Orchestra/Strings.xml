<Block>
	<Debug>false</Debug>
	<ID>4</ID>
	<Name>Strings</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>strings</Keyword>
		<Keyword>violin</Keyword>
		<Keyword>cello</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<OrchestraMod modid="aca735ea-a614-4aef-9676-67ec1edd5059" block="Strings">
			<Types>
			<Type name="Violin"      engine="sampler" samples="strings_violin_56 strings_violin_65 strings_violin_80" loops="27987-32058 25385-29549 21641-25492" damped="true" holds="true" attack="0.06" release="0.3" />
			<Type name="Viola"       engine="sampler" samples="strings_viola_49 strings_viola_61 strings_viola_73" loops="18421-22739 24574-29405 25831-30753" damped="true" holds="true" attack="0.06" release="0.3" />
			<Type name="Cello"       engine="sampler" samples="strings_cello_37 strings_cello_47 strings_cello_59" loops="24938-29733 19852-24504 22779-26975" damped="true" holds="true" attack="0.07" release="0.35" />
			<Type name="Double bass" engine="sampler" samples="strings_dbass_29 strings_dbass_41 strings_dbass_52" loops="21274-26360 15684-21287 18835-23010" damped="true" holds="true" attack="0.08" release="0.4" />
			<Type name="Ensemble"    engine="sampler" samples="strings_ens_49 strings_ens_61 strings_ens_73" loops="37629-69761 26280-47534 7300-28698" damped="true" holds="true" attack="0.12" release="0.6" />
			<!-- Voices, which are strings in every way that matters here: bowed
			     into life and held. These were detuned saws through three formant
			     filters until a font was cut for them. -->
			<Type name="Choir"       engine="sampler" samples="strings_choir_48 strings_choir_60 strings_choir_72" loops="31399-66481 28702-56398 12397-36607" damped="true" holds="true" attack="0.30" release="0.5" />
			</Types>
			<Extras>
			<Extra kind="toggle" key="PizzKey" name="Pizzicato" default="0" />
			<Extra kind="slider" key="VibratoKey" name="Vibrato" min="0" max="1" default="0.3" />
			</Extras>
		</OrchestraMod>
	</Modules>

	<Mesh name="Strings_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="Strings_texture" />

	<Icon>
		<Position x="0.0" y="0.0" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-65.0" y="210.0" z="115.0" /> <!--how the toolbar sees it: the front, from above, turned right into the light-->
		<Scale x="0.5" y="0.5" z="0.5" />
	</Icon>
	
	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
		<Position x="0" y="0" z="0.3" />
		<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" /> 
	</BasePoint>
	
	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
