<Block>
	<Debug>false</Debug>
	<ID>1</ID>
	<Name>Piano</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>piano</Keyword>
		<Keyword>keys</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<OrchestraMod modid="aca735ea-a614-4aef-9676-67ec1edd5059" block="Piano" default="Upright piano">
			<Types>
			<Type name="Grand piano"    engine="sampler" samples="piano_grand_38 piano_grand_60 piano_grand_86" loops="33983-55757 21957-44474 12297-22425" decay="3.5" damped="true" release="0.5" />
			<Type name="Upright piano"  engine="sampler" samples="piano_upright_38 piano_upright_60 piano_upright_86" loops="33983-55757 21957-44474 12297-22425" decay="2.4" damped="true" release="0.4" />
			<Type name="Electric piano" engine="sampler" samples="piano_rhodes_38 piano_rhodes_55 piano_rhodes_80" loops="4571-4872 3325-3437 1255-1281" decay="3" damped="true" release="0.6" />
			<Type name="Honky-tonk"     engine="sampler" samples="piano_honky_38 piano_honky_60 piano_honky_86" loops="33983-55757 21957-44474 12297-22425" decay="2.5" damped="true" release="0.4" />
			</Types>
			<Extras>
			<Extra kind="toggle" key="SustainKey" name="Sustain" default="0" />
			<Extra kind="slider" key="ReleaseKey" name="Release" min="0.05" max="60" dragMax="6" default="0.5" />
			</Extras>
		</OrchestraMod>
	</Modules>

	<Mesh name="Piano_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="Piano_texture" />

	<Icon>
		<Position x="0.0" y="0.0" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-65.0" y="210.0" z="115.0" /> <!--how the toolbar sees it: the front, from above, turned right into the light-->
		<Scale x="0.45" y="0.45" z="0.45" /> <!--a grand is the widest of the nine-->
	</Icon>
	
	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
		<Position x="0" y="0" z="0.3" />
		<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" /> 
	</BasePoint>
	
	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
