<Block>
	<Debug>false</Debug>
	<ID>9</ID>
	<Name>Cymbals</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>cymbals</Keyword>
		<Keyword>crash</Keyword>
		<Keyword>ride</Keyword>
		<Keyword>hihat</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<OrchestraMod modid="aca735ea-a614-4aef-9676-67ec1edd5059" block="Cymbals">
			<Types>
			<!-- Recordings, and the change that matters most in the mod. A cymbal
			     is a few hundred modes of a thin bronze disc, dense enough to be
			     heard as noise; the modal engine rings twenty-four, which is a
			     bell, not a crash. Cut at 44.1 kHz where the rest of the mod is at
			     22 — a cymbal is mostly above 8 kHz, and half of it is simply not
			     there at the lower rate. -->
			<Type name="Crash"  engine="sampler" samples="cymbal_crash_60"  decay="3.5" />
			<Type name="Ride"   engine="sampler" samples="cymbal_ride_60"   decay="3.0" />
			<!-- Both hats. A closed hi-hat is not an open one with the ring taken
			     off; it is a tighter, drier sound of its own. The block picks by
			     note — 60 is the closed recording, 72 the open one, each played
			     as recorded — and a score writes 72 where it says open hat. OPEN
			     still chokes either of them. -->
			<Type name="Hi-hat" engine="sampler" samples="cymbal_hihat_60 cymbal_hihatopen_72" decay="0.8" />
			<Type name="Splash" engine="sampler" samples="cymbal_splash_60" decay="2.0" />
			<!-- No General MIDI font has a gong. This is the Chinese cymbal — a
			     big thin disc with a long dark wash, which is the nearest thing —
			     published an octave high, so the block at its own default note
			     plays it an octave down. That is most of what separates the two. -->
			<Type name="Gong"   engine="sampler" samples="cymbal_gong_72"   decay="5.0" />
			</Types>
			<Extras>
			<Extra kind="slider" key="SizeKey" name="Size" min="0" max="1" default="0.5" />
			<Extra kind="toggle" key="OpenKey" name="Open" default="1" />
			</Extras>
		</OrchestraMod>
	</Modules>

	<Mesh name="Cymbals_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="Cymbals_texture" />

	<Icon>
		<Position x="0.0" y="0.0" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-31.3" y="156.7" z="-151.6" /> <!--how the toolbar sees it: looking down at the cymbal, which faces right-->
		<Scale x="0.5" y="0.5" z="0.5" />
	</Icon>
	
	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
		<Position x="0" y="0" z="0.3" />
		<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" /> 
	</BasePoint>
	
	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
