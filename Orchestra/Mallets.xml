<Block>
	<Debug>false</Debug>
	<ID>7</ID>
	<Name>Mallets</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>mallets</Keyword>
		<Keyword>vibraphone</Keyword>
		<Keyword>marimba</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<OrchestraMod modid="aca735ea-a614-4aef-9676-67ec1edd5059">
			<Types>
			<Type name="Glockenspiel"  engine="modal" decay="2.5" brightness="0.75" inharmonicity="1.35" noise="0.12" />
			<Type name="Vibraphone"    engine="modal" decay="4.0" brightness="0.45" inharmonicity="1.18" noise="0.08" />
			<Type name="Marimba"       engine="modal" decay="1.2" brightness="0.35" inharmonicity="1.10" noise="0.15" />
			<Type name="Xylophone"     engine="modal" decay="0.8" brightness="0.60" inharmonicity="1.22" noise="0.18" />
			<Type name="Tubular bells" engine="modal" decay="6.0" brightness="0.55" inharmonicity="1.28" noise="0.06" />
			</Types>
			<Extras>
			<Extra kind="slider" key="HardKey" name="Hardness" min="0" max="1" default="0.5" />
			<Extra kind="slider" key="MotorKey" name="Motor" min="0" max="1" default="0" />
			</Extras>
		</OrchestraMod>
	</Modules>

	<Mesh name="OrchestraBlock_mesh" >
		<Position x="0.45" y="-0.45" z="0.0" />
		<Rotation x="-90.0" y="-90.0" z="-90.0" />
		<Scale x="1" y="1" z="1" />
	</Mesh>

	<Texture name="Mallets_texture" />

	<Icon>
		<Position x="-0.15" y="-0.35" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-30.0" y="-30.0" z="0.0" /> <!--left, down, front-->
		<Scale x="0.5" y="0.5" z="0.5" />
	</Icon>
	
	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
		<Position x="0" y="0" z="0.3" />
		<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" /> 
	</BasePoint>
	
	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
