<Mod>
	<Name>Orchestra</Name>
	<Author>wizz6rd</Author>
	<Version>0.1.0</Version>

	<Description>
	Nine instrument blocks: piano, guitar, bass, strings, brass, woodwind,
	mallets, drums and cymbals. Each plays a note on a key, heard where it is.

	Block models by jeremy, Daniel Melchior and Poly by Google, from Poly Pizza,
	under CC-BY 3.0. Sampled instruments cut from GeneralUser GS.
	</Description>

	<Icon name="Orchestra_icon" />
	<Debug>false</Debug>
	<MultiplayerCompatible>true</MultiplayerCompatible>

	<Assemblies>
		<Assembly path="Orchestra.dll" />
	</Assemblies>

	<Blocks>
		<Block path="Piano.xml" />
		<Block path="Guitar.xml" />
		<Block path="Bass.xml" />
		<Block path="Strings.xml" />
		<Block path="Brass.xml" />
		<Block path="Woodwind.xml" />
		<Block path="Mallets.xml" />
		<Block path="Drums.xml" />
		<Block path="Cymbals.xml" />

		<!-- Not an instrument: the block that turns a MIDI file into a machine. -->
		<Block path="Loader.xml" />
	</Blocks>

