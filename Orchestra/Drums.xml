<Block>
	<Debug>false</Debug>
	<ID>8</ID>
	<Name>Drums</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>drums</Keyword>
		<Keyword>kick</Keyword>
		<Keyword>snare</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<OrchestraMod modid="aca735ea-a614-4aef-9676-67ec1edd5059" block="Drums">
			<Types>
			<Type name="Kick"  engine="drum" decay="0.45" noise="0.18" pitchDrop="26" />
			<Type name="Snare" engine="drum" decay="0.30" noise="0.80" pitchDrop="6" />
			<Type name="Tom"   engine="drum" decay="0.60" noise="0.30" pitchDrop="10" />
			<Type name="Rim"   engine="drum" decay="0.12" noise="0.65" pitchDrop="3" />
			<Type name="Clap"  engine="drum" decay="0.22" noise="0.95" pitchDrop="0" />
			</Types>
			<Extras>
			<Extra kind="slider" key="TuneKey" name="Tune" min="-12" max="12" default="0" />
			<Extra kind="slider" key="DecayKey" name="Decay" min="0.05" max="2" default="0.45" />
			<Extra kind="slider" key="DampKey" name="Damping" min="0" max="1" default="0.3" />
			</Extras>
		</OrchestraMod>
	</Modules>

	<Mesh name="Drums_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="Drums_texture" />

	<Icon>
		<Position x="0.0" y="0.0" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-31.3" y="156.7" z="-151.6" /> <!--how the toolbar sees it: looking down at the head, which faces right-->
		<Scale x="0.4" y="0.4" z="0.4" /> <!--a drum is as wide as the block is, and filled its tile-->
	</Icon>
	
	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
		<Position x="0" y="0" z="0.3" />
		<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" /> 
	</BasePoint>
	
	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
