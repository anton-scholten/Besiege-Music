<Block>
	<Debug>false</Debug>
	<ID>2</ID>
	<Name>Guitar</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>guitar</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>
	<Fallback>Ballast</Fallback>

	<Modules>
		<OrchestraMod modid="aca735ea-a614-4aef-9676-67ec1edd5059" block="Guitar">
			<Types>
			<Type name="Nylon"      engine="sampler" samples="guitar_nylon_40 guitar_nylon_50 guitar_nylon_64" loops="96405-96672 99417-100018 19416-19684" decay="1.6" />
			<Type name="Steel"      engine="sampler" samples="guitar_steel_40 guitar_steel_50 guitar_steel_64" loops="110261-111340 94186-94787 33370-33904" decay="2.2" />
			<Type name="Jazz"       engine="sampler" samples="guitar_jazz_40 guitar_jazz_54 guitar_jazz_64" loops="37973-38505 34602-35191 19667-20124" decay="1.8" />
			<Type name="Clean"      engine="sampler" samples="guitar_clean_40 guitar_clean_50 guitar_clean_64" loops="35331-35859 38255-39300 21373-21705" decay="2.4" />
			<Type name="Overdriven" engine="sampler" samples="guitar_drive_40 guitar_drive_50 guitar_drive_64" loops="245954-247023 238520-239122 75802-76273" decay="2.8" />
			</Types>
			<Extras>
			<Extra kind="slider" key="PluckKey" name="Pluck" min="0" max="1" default="0.3" />
			<Extra kind="toggle" key="MuteKey" name="Palm mute" default="0" />
			</Extras>
		</OrchestraMod>
	</Modules>

	<Mesh name="Guitar_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="Guitar_texture" />

	<Icon>
		<Position x="0.0" y="0.0" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-65.0" y="210.0" z="115.0" /> <!--how the toolbar sees it: the front, from above, turned right into the light-->
		<Scale x="0.5" y="0.5" z="0.5" />
	</Icon>
	
	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
		<Position x="0" y="0" z="0.3" />
		<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" /> 
	</BasePoint>
	
	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
